# NetShield environment template.
#
# Copy this file to .env and fill in real values. The .env file is
# gitignored — never commit your actual API key.
#
#   cp .env.example .env
#   # then edit .env and replace the placeholder

# Required for the AI mitigation pipeline (analyzer + strategist agents).
# Get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional. Seconds to sleep between the Analyzer and Strategist calls so
# the free-tier token bucket doesn't flag back-to-back API calls as a burst.
# Default is 3.0 — set to 0 on paid tiers to remove the artificial latency.
# NETSHIELD_BURST_DELAY=3.0
